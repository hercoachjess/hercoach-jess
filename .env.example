# ─────────────────────────────────────────────────────────────────────────
# hercoach · Jess — environment variables
# Copy this file to `.env.local` and fill in the values. Never commit .env.local.
# In Vercel, add these under Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────────────────

# Supabase — Project Settings → Data API (and API Keys)
#   NEXT_PUBLIC_SUPABASE_URL   : "Project URL"        (Settings → Data API)
#   NEXT_PUBLIC_SUPABASE_ANON_KEY : "anon / publishable" key (Settings → API Keys)
# These two are public (safe to expose in the browser) and power the public
# enquiry / onboarding / check-in forms.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Supabase service-role key — Settings → API Keys → "service_role" (secret).
# SERVER-ONLY. Never prefix with NEXT_PUBLIC and never expose to the browser.
# Used by the admin client for privileged inserts/reads (e.g. enquiries).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Anthropic Claude API — https://console.anthropic.com → API Keys.
# Server-only. Powers the coach-side AI drafting routes.
ANTHROPIC_API_KEY=sk-ant-your-key

# Public base URL of the deployed app (used to build absolute links).
# Local: http://localhost:3000 · Production: your Vercel/production URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000
